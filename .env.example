# Isi dengan URL HTTPS API publik, tanpa suffix /api/v1
HOTEL_API_URL=https://nama-hotel.workers.dev
WISATA_API_URL=https://nama-wisata.vercel.app
# Hanya server Go, JANGAN dimasukkan ke kode browser
HOTEL_PARTNER_TOKEN=isi-token-partner-hotel
WISATA_PARTNER_TOKEN=isi-token-partner-wisata
# Untuk hosting Render Free gunakan Supabase REST sebagai database persisten:
SUPABASE_URL=https://nama-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
PORT=8080
