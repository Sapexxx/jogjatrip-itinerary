{
  "name": "jogjatrip-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply jogjatrip-db --local",
    "db:remote": "wrangler d1 migrations apply jogjatrip-db --remote",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:ux-tokens": "node tools/check-tokens.mjs",
    "check:transport-live": "node tools/check-transport-live.mjs",
    "typecheck": "npx --yes --package typescript@5.9.3 tsc --noEmit",
    "check:interop-readonly-staging": "node --experimental-strip-types tools/check-interop-contract-readonly.mjs",
    "check:i6-release-evidence": "node tools/check-i6-release-evidence.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261118.0-beta",
    "wrangler": "4.165.0"
  }
}
