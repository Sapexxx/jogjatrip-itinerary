{
  "name": "jogjatrip-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply jogjatrip-db --local",
    "db:remote": "wrangler d1 migrations apply jogjatrip-db --remote",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:transport-live": "node tools/check-transport-live.mjs",
    "typecheck": "npx --yes --package typescript@5.9.3 tsc --noEmit"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
